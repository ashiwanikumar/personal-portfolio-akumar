    "agenda": "^5.0.0",
    "ansi-colors": "^4.1.3",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^10.0.0",
