{
  "name": "digisvc-server",
  "version": "1.0.0",
  "description": "backend for the digisvc client",
  "main": "server.js",
  "scripts": {
    "dev": "npx nodemon server.js",
    "start": "node server.js",
    "test": "jest --watchAll --no-cache --runInBand --coverage"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/jest.setup.js"
    ],
    "collectCoverage": true
