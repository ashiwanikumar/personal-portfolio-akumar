BACKEND_API=

# ─── Gmail CV outreach (dashboard → CV Outreach) ──────────────────────────────
# Desktop ("installed") OAuth client from Google Cloud Console.
# Get the refresh token once with: cd apps/api-server && npm run gmail:auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost
GMAIL_AUTH_PORT=5599

# What counts as a CV email (regex on the attachment filename, case-insensitive)
GMAIL_CV_FILENAME_REGEX=cv|resume|curriculum[ _-]?vitae|profile
GMAIL_CV_ATTACHMENT_TYPES=pdf,doc,docx
# Extra Gmail search terms appended to the sync query, e.g. -label:personal
GMAIL_CV_EXTRA_QUERY=

# Sync behaviour
GMAIL_SYNC_CRON=*/30 * * * *
GMAIL_SYNC_LOOKBACK_DAYS=365
GMAIL_SYNC_MAX_MESSAGES=500
GMAIL_REPLY_WINDOW_DAYS=60
GMAIL_REPLY_CHECK_LIMIT=80
